                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string",
                      "example": "Image uploaded successfully"
                    },
                    "data": {
                      "type": "string",
                      "example": "OSo5op28"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid image upload data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
