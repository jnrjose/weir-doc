    "/ad/validateIdentity": {
      "post": {
        "summary": "Submit Ad for Identity Validation",
        "operationId": "submitAdValidateIdentity",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "description": "Ad validation payload",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "adName": {
                    "type": "string",
                    "example": "Lekan onMongo"
                  },
                  "ad": {
                    "type": "string",
                    "example": "Hardcoded uris"
                  }
                },
                "required": ["adName", "ad"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tracking ID returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "success"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "trackingId": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request - Invalid ad validation payload",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
